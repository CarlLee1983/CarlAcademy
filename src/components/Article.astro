---
import { render, type CollectionEntry } from 'astro:content';
import ArticleNavigation from './ArticleNavigation.astro';
import TableTools from './TableTools.astro';
import ReadingSettings from './ReadingSettings.astro';
import ReadingNavigation from './ReadingNavigation.astro';
import { topicName } from '../utils/collections';
import { topics, withBase } from '../utils/urls';
import '../styles/article.css';
import CodeTools from './CodeTools.astro';
interface Props {
  entry: CollectionEntry<'documents'>;
  topicIndex: CollectionEntry<'documents'>;
  articles: CollectionEntry<'documents'>[];
}
const { entry, topicIndex, articles } = Astro.props;
const { headings } = await render(entry);
const titleHeading = headings.find(heading => heading.depth === 1)!;
const chapters = headings.filter(heading => heading.depth > 1);
// Use the collection's rendered output so anchors and Markdown extensions have one pipeline.
// Its single source title is displayed in the cover instead of repeated in the reading column.
const renderedBody = entry.rendered!.html.replace(/<h1\b[^>]*>[\s\S]*?<\/h1>/i, '');
const introduction = renderedBody.match(/<p\b[^>]*>[\s\S]*?<\/p>/i)?.[0] ?? '';
const html = renderedBody.replace(introduction, '');
const position = articles.findIndex(doc => doc.id === entry.id);
const previous = articles[position - 1];
const next = articles[position + 1];
const pad = (number: number) => String(number).padStart(2, '0');
const checkedDate = entry.body?.match(/查證日期[：:]\s*(\d{4}-\d{2}-\d{2})/)?.[1];
const base = import.meta.env.BASE_URL;
---
<article class="article-page" data-pagefind-body>
  <ReadingNavigation headings={chapters} />
  <div class="shell">
    <nav class="article-breadcrumb" aria-label="麵包屑" data-pagefind-ignore>
      <a href={withBase('/', base)}>所有主題</a>
      <a href={withBase(topicIndex.data.route, base)}>{topicName(topicIndex.data.title)}</a>
      <span aria-current="page">{entry.data.title}</span>
    </nav>
    <header class="masthead article-masthead">
      <p class="kicker"><span>{topicName(topicIndex.data.title)}</span><span class="document-position">文件 {pad(position + 1)}／{pad(articles.length)}</span><span class="article-topic-number" aria-hidden="true">{pad(topics.indexOf(entry.data.topic as typeof topics[number]) + 1)}</span></p>
      <div class="masthead-grid">
        <h1 id={titleHeading.slug}>{entry.data.title}</h1>
        <div class="abstract"><p class="abstract-label" data-pagefind-ignore>本文提要</p><Fragment set:html={introduction} /></div>
      </div>
    </header>
    <ReadingSettings />
    <details class="mobile-chapters" data-pagefind-ignore>
      <summary>文件與本文目錄</summary>
      <ArticleNavigation headings={chapters} articles={articles} currentId={entry.id} />
      {checkedDate && <p class="article-date">查證日期：<time datetime={checkedDate}>{checkedDate}</time></p>}
    </details>
    <div class="article-layout">
      <aside class="article-sidebar" aria-label="文章導覽" data-pagefind-ignore>
        <ArticleNavigation headings={chapters} articles={articles} currentId={entry.id} />
        {checkedDate && <p class="edition">查證日期<time datetime={checkedDate}>{checkedDate}</time></p>}
      </aside>
      <div class="reading" id="article-body">
        <div class="mobile-lede" data-pagefind-ignore set:html={introduction} />
        <Fragment set:html={html} />
      </div>
    </div>
    <nav class="article-next" aria-label="接續閱讀" data-pagefind-ignore>
      {previous && <a rel="prev" href={withBase(previous.data.route, base)}><small>上一篇</small><span>{previous.data.title}</span></a>}
      {next && <a rel="next" href={withBase(next.data.route, base)}><small>下一篇</small><span>{next.data.title}</span></a>}
    </nav>
  </div>
</article>
<TableTools />
<CodeTools />
